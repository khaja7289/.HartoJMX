        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="PaceTime" enabled="true"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="PaceTime" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.concurrent.ThreadLocalRandom

try {
    long iterStart = Long.parseLong(vars.get(&quot;v_IterStartTime&quot;))
    long iterEnd   = System.currentTimeMillis()
    vars.put(&quot;v_IterEndTime&quot;, String.valueOf(iterEnd))

    long iterDuration   = iterEnd - iterStart
    long pacingInterval = Long.parseLong(vars.get(&quot;v_PacingInterval&quot;))

    // Remaining time in the interval, with ±20% jitter (80–120%)
    long pacingDelay = pacingInterval - iterDuration
    pacingDelay = (long) (pacingDelay * ThreadLocalRandom.current().nextInt(80, 120) / 100.0)

    if (pacingDelay &gt; 0) {
        vars.put(&quot;v_PacingDelay&quot;, String.valueOf(pacingDelay))
        vars.put(&quot;v_PacingMissed&quot;, &quot;false&quot;)
    } else {
        vars.put(&quot;v_PacingDelay&quot;, &quot;0&quot;)
        vars.put(&quot;v_PacingMissed&quot;, &quot;true&quot;)
        log.warn(&quot;No pacing delay: iteration took &quot; + iterDuration + &quot; ms, interval is &quot; +
                 pacingInterval + &quot; ms. Target TPH will not be achieved for this thread group. &quot; +
                 &quot;The application may be slow, or increase the user count.&quot;)
    }

} catch (Exception e) {
    vars.put(&quot;v_PacingDelay&quot;, &quot;0&quot;)
    log.error(&quot;Exception in zz_CalculatePacingDelay: &quot; + e)
} finally {
    SampleResult.setIgnore()
}</stringProp>
          </JSR223Sampler>
