          <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Once Only Controller"/>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="PaceInterval">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    String testType = vars.get(&quot;v_TestType&quot;) ?: &quot;Load&quot;    // Smoke | Load | Duration
    String tgName   = ctx.getThreadGroup().getName()

    String usersStr = vars.get(tgName + &quot;_Users&quot;) ?: vars.get(&quot;Test_Users&quot;) ?: vars.get(&quot;Users&quot;)
    String tphStr   = vars.get(tgName + &quot;_TPH&quot;)   ?: vars.get(&quot;Test_TPH&quot;)   ?: vars.get(&quot;TPH&quot;)

    if (usersStr == null || tphStr == null) {
        throw new IllegalArgumentException(&quot;Users or TPH variable missing for thread group: &quot; + tgName)
    }

    long   users = Long.parseLong(usersStr.trim())
    double tph   = Double.parseDouble(tphStr.trim())

    switch (testType) {
        case &quot;Smoke&quot;:
        case &quot;Load&quot;:
            break                                          // 100% of target TPH
        case &quot;Duration&quot;:
            tph = tph * 0.75                               // 75% of target TPH
            break
        default:
            log.warn(&quot;Unknown v_TestType &apos;&quot; + testType + &quot;&apos;, using 100% of TPH&quot;)
    }

    if (users &lt;= 0 || tph &lt;= 0) {
        throw new IllegalArgumentException(&quot;Users=&quot; + users + &quot;, TPH=&quot; + tph + &quot; must be &gt; 0&quot;)
    }

    // Per-user interval: 3,600,000 ms / (TPH / Users), computed in double to avoid truncation
    long pacingInterval = Math.round(3600000d * users / tph)
    vars.put(&quot;v_PacingInterval&quot;, String.valueOf(pacingInterval))

    log.info(&quot;Running &quot; + testType + &quot; test | TG: &quot; + tgName +
             &quot; | Users: &quot; + users + &quot; | TPH: &quot; + tph +
             &quot; | Pacing Interval: &quot; + pacingInterval + &quot; ms&quot; +
             &quot; | Think Time: &quot; + vars.get(&quot;v_ThinkTime&quot;) + &quot; ms&quot;)

} catch (NumberFormatException ex) {
    log.error(&quot;NumberFormatException in zz_CalculatePacingInterval: &quot; + ex)
    log.error(&quot;Ensure &lt;ThreadGroupName&gt;_Users and &lt;ThreadGroupName&gt;_TPH (or Test_Users / Test_TPH) exist and are numeric&quot;)
} catch (Exception e) {
    log.error(&quot;Exception in zz_CalculatePacingInterval: &quot; + e)
} finally {
    SampleResult.setIgnore()
}</stringProp>
            </JSR223Sampler>
