          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="StartTime">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    vars.put(&quot;v_IterStartTime&quot;, String.valueOf(System.currentTimeMillis()))
} catch (Exception e) {
    log.error(&quot;Exception in zz_SaveIterStartTime: &quot; + e)
}
SampleResult.setIgnore()</stringProp>
          </JSR223Sampler>
