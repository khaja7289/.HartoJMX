          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="ThinkTime">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.concurrent.ThreadLocalRandom

// Think time: random 1500-2500 ms (avg 2000)
int thinkTime = ThreadLocalRandom.current().nextInt(1500, 2501)
vars.put(&quot;v_ThinkTime&quot;, String.valueOf(thinkTime))
SampleResult.setIgnore()
</stringProp>
